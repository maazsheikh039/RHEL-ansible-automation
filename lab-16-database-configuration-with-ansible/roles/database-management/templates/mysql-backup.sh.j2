#!/bin/bash
set -euo pipefail

BACKUP_DIR="/opt/database-backups"
DATE=$(date +%Y%m%d_%H%M%S)
MYSQL_USER="root"
MYSQL_PASSWORD="{{ mysql_root_password }}"
RETENTION_DAYS="{{ backup_retention_days }}"

mkdir -p "$BACKUP_DIR"

mysqldump -u"$MYSQL_USER" -p"$MYSQL_PASSWORD" --all-databases --single-transaction --routines --triggers \
  | gzip > "$BACKUP_DIR/mysql_backup_$DATE.sql.gz"

find "$BACKUP_DIR" -name "mysql_backup_*.sql.gz" -mtime +"$RETENTION_DAYS" -delete

echo "MySQL backup completed: mysql_backup_$DATE.sql.gz"
